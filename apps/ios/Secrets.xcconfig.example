// Copy this file to Secrets.xcconfig (gitignored, never committed) and
// fill in the real value. Mirrors apps/mobile/.env.local's
// VITE_CLERK_PUBLISHABLE_KEY convention for the same Clerk instance.
//
// Codemagic must set this the same way — as a build environment variable
// or an injected xcconfig, not a committed value.

CLERK_PUBLISHABLE_KEY = pk_test_REPLACE_ME

// Sombrey Membership (StoreKit 2, docs/COMMERCE_6B.md). Leave EMPTY until the
// subscription exists in App Store Connect — the app then offers nothing to buy.
// For local StoreKit testing in Xcode only, use the testing file's id:
//   SOMBREY_MEMBERSHIP_PRODUCT_ID = sombrey.storekit_testing.membership_monthly
// Never put a testing id in a TestFlight/App Store build.
SOMBREY_MEMBERSHIP_PRODUCT_ID =
