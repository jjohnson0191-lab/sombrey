<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Sombrey</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Native OAuth/session callback scheme. ClerkKit's default
	     RedirectConfig targets exactly this — see ClerkAuthCoordinator.swift.
	     Deliberately NOT com.sombrey.app://localhost (the retired
	     Capacitor/WKWebView scheme). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sombrey.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.sombrey.app</string>
			</array>
		</dict>
	</array>

	<!-- Bricolage Grotesque + Instrument Sans — exact weight set the web
	     app loads from Google Fonts in apps/mobile/index.html, bundled
	     here as static .ttf files. -->
	<key>UIAppFonts</key>
	<array>
		<string>BricolageGrotesque-SemiBold.ttf</string>
		<string>BricolageGrotesque-Bold.ttf</string>
		<string>InstrumentSans-Regular.ttf</string>
		<string>InstrumentSans-Medium.ttf</string>
		<string>InstrumentSans-MediumItalic.ttf</string>
		<string>InstrumentSans-SemiBold.ttf</string>
		<string>InstrumentSans-Bold.ttf</string>
	</array>

	<!-- Populated via Secrets.xcconfig (not committed) — see
	     Secrets.xcconfig.example and ClerkAuthCoordinator.configure(). -->
	<key>ClerkPublishableKey</key>
	<string>$(CLERK_PUBLISHABLE_KEY)</string>

	<!-- Sombrey Band (QCBandSDK) — Phase 3 native wearable integration.
	     Keys/usage-description text per the vendor's own SDK Development
	     Guide (Section 1.2). NSBluetoothPeripheralUsageDescription is the
	     pre-iOS13 key; harmless to include alongside the modern
	     NSBluetoothAlwaysUsageDescription. `bluetooth-central` background
	     mode matches QCBandSDKService's use of
	     CBCentralManagerOptionRestoreIdentifierKey for reconnecting to a
	     previously-paired band after the app is backgrounded. -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Sombrey uses Bluetooth to connect to your Sombrey Band and sync your activity, sleep, and heart rate.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Sombrey uses Bluetooth to connect to your Sombrey Band and sync your activity, sleep, and heart rate.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>

	<!-- Phase 3 training-architecture expansion: GPS-tagged Sport+ session
	     types (GPS Run/Bike/Walk, outdoor cycling/hiking) request phone
	     location — the band has no onboard GPS chip (see GPSTracker.swift
	     and the Phase 3 wearable audit). When-in-use only; never requests
	     Always. -->
	<key>NSCameraUsageDescription</key>
	<string>Sombrey uses the camera only when you choose to: a profile photo, a photo of a meal for the AI Macro Calculator, or your Body Scan photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sombrey uses your location to record the route during outdoor GPS workouts like running and cycling, and your approximate location to show local weather. Coordinates are never stored.</string>
</dict>
</plist>
